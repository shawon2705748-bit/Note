<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->
        <LinearLayout
            android:id="@+id/layout_top_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_toolbar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <!-- Auto-save / Status indicator -->
            <TextView
                android:id="@+id/tv_save_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Saved • 4:15 PM" />

            <!-- Pin / Unpin Button -->
            <ImageButton
                android:id="@+id/btn_pin_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pin"
                android:padding="8dp"
                android:src="@drawable/ic_pin_outline"
                app:tint="@color/text_secondary" />

            <!-- Switch Mode Button (View / Edit) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_toggle"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="@string/edit"
                android:textColor="@color/purple_accent_light"
                android:textSize="13sp"
                app:backgroundTint="@color/purple_accent_container"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_edit"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/purple_accent_light" />

            <!-- More Overflow Menu Button -->
            <ImageButton
                android:id="@+id/btn_note_overflow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_vert"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:id="@+id/top_bar_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_card_stroke"
            app:layout_constraintTop_toBottomOf="@id/layout_top_bar" />

        <!-- Scrollable Content View -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/layout_formatting_toolbar"
            app:layout_constraintTop_toBottomOf="@id/top_bar_divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="48dp">

                <!-- VIEW MODE LAYOUT -->
                <LinearLayout
                    android:id="@+id/layout_view_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_view_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="Architecture &amp; Strategy" />

                    <TextView
                        android:id="@+id/tv_view_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        tools:text="Created Oct 19, 2026 • 9:00 AM" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/bg_card_stroke" />

                    <TextView
                        android:id="@+id/tv_view_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="6dp"
                        android:linksClickable="true"
                        android:textColor="@color/text_primary"
                        android:textColorLink="@color/text_link"
                        android:textSize="16sp"
                        tools:text="Here is the detailed thoughts on our dark mode note app. With bold and italic accents." />
                </LinearLayout>

                <!-- EDIT MODE LAYOUT -->
                <LinearLayout
                    android:id="@+id/layout_edit_mode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible"
                    tools:visibility="visible">

                    <EditText
                        android:id="@+id/et_edit_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/transparent"
                        android:fontFamily="sans-serif-medium"
                        android:hint="@string/title_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="3"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/bg_card_stroke" />

                    <EditText
                        android:id="@+id/et_edit_body"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/transparent"
                        android:fontFamily="sans-serif"
                        android:gravity="top|start"
                        android:hint="@string/note_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:lineSpacingExtra="6dp"
                        android:minLines="15"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textColorLink="@color/text_link"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- FORMATTING TOOLBAR (Visible in Edit Mode only) -->
        <LinearLayout
            android:id="@+id/layout_formatting_toolbar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/bg_bottom_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Bold Button -->
            <ImageButton
                android:id="@+id/btn_format_bold"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/bold"
                android:padding="8dp"
                android:src="@drawable/ic_format_bold"
                app:tint="@color/text_primary" />

            <!-- Italic Button -->
            <ImageButton
                android:id="@+id/btn_format_italic"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/italic"
                android:padding="8dp"
                android:src="@drawable/ic_format_italic"
                app:tint="@color/text_primary" />

            <!-- Hyperlink Button -->
            <ImageButton
                android:id="@+id/btn_format_link"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/add_link"
                android:padding="8dp"
                android:src="@drawable/ic_insert_link"
                app:tint="@color/text_primary" />

            <!-- Regular / Clear Formatting Button -->
            <ImageButton
                android:id="@+id/btn_format_clear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/clear_formatting"
                android:padding="8dp"
                android:src="@drawable/ic_format_clear"
                app:tint="@color/text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Character/Word count or Info label -->
            <TextView
                android:id="@+id/tv_word_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                tools:text="0 words" />

        </LinearLayout>

        <!-- Divider above toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_card_stroke"
            app:layout_constraintBottom_toTopOf="@id/layout_formatting_toolbar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
