<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Note" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/purple_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/purple_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/purple_accent_light</item>

        <item name="android:windowBackground">@color/bg_main</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_card</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Dialogs -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Note.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.Note.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/bg_dialog</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/purple_accent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Note.Dialog</item>
    </style>

    <style name="ShapeAppearance.Note.Dialog" parent="">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Note.Card" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Note.Pill" parent="">
        <item name="cornerSize">24dp</item>
    </style>
</resources>
